# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env*.local

# local SQLite build (800MB+, regenerated by scripts/etl/06_build_sqlite.ts; production reads
# from Turso, not this file — see db/README.md)
/db/properties.db
/db/properties.db-*

# Map ETL scratch inputs (raw PLUTO/boundary downloads + unsimplified geojson; regenerated by
# scripts/etl/07_geocode.ts + scripts/etl/10_build_map_geojson.ts). The simplified outputs
# (data/map/*.geojson, no _raw/) ARE committed — those are what /map reads.
/data/map/_raw/
